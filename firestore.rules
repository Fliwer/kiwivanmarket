rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ╔══════════════════════════════════════════════════════════════════╗
    // ║                                                                   ║
    // ║   🥝 KIWI VAN MARKET - FIRESTORE SECURITY RULES                  ║
    // ║                                                                   ║
    // ║   Version: 2.0.0                                                  ║
    // ║   Last Updated: December 2024                                     ║
    // ║   Security Level: Production Ready                                ║
    // ║                                                                   ║
    // ╚══════════════════════════════════════════════════════════════════╝
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🔐 SECTION 1: AUTHENTICATION FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════
    
    /// Vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /// Vérifie si l'utilisateur est le propriétaire du document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    /// Vérifie si l'utilisateur est admin (par email ou custom claim)
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == 'p.morthier@gmail.com' ||
              request.auth.token.admin == true);
    }
    
    /// Vérifie si l'email est vérifié
    function hasVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }
    
    /// Récupère l'UID de l'utilisateur actuel
    function currentUserId() {
      return request.auth.uid;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 📏 SECTION 2: VALIDATION FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════
    
    /// Vérifie qu'une chaîne respecte les limites de taille
    function isValidString(field, minLen, maxLen) {
      return field is string && 
             field.size() >= minLen && 
             field.size() <= maxLen;
    }
    
    /// Vérifie qu'un string n'est pas vide
    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }
    
    /// Vérifie qu'un nombre est positif
    function isPositiveNumber(field) {
      return field is number && field > 0;
    }
    
    /// Vérifie qu'un nombre est >= 0
    function isNonNegativeNumber(field) {
      return field is number && field >= 0;
    }
    
    /// Vérifie un prix valide (1 - 500,000 NZD)
    function isValidPrice(price) {
      return price is number && price >= 1 && price <= 500000;
    }
    
    /// Vérifie une année valide (1950 - 2026)
    function isValidYear(year) {
      return year is number && year >= 1950 && year <= 2026;
    }
    
    /// Vérifie un kilométrage valide (0 - 1,000,000 km)
    function isValidMileage(mileage) {
      return mileage is number && mileage >= 0 && mileage <= 1000000;
    }
    
    /// Vérifie un rating valide (1-5 étoiles)
    function isValidRating(rating) {
      return rating is number && rating >= 1 && rating <= 5;
    }
    
    /// Vérifie une URL d'image valide (Cloudinary ou Firebase Storage)
    function isValidImageUrl(url) {
      return url is string && 
             (url.matches('https://res\\.cloudinary\\.com/.*') || 
              url.matches('https://firebasestorage\\.googleapis\\.com/.*'));
    }
    
    /// Vérifie un tableau d'images (1-10 images)
    function hasValidImages(images) {
      return images is list && 
             images.size() >= 1 && 
             images.size() <= 10;
    }
    
    /// Vérifie un email valide (format basique)
    function isValidEmail(email) {
      return email is string && 
             email.matches('.*@.*\\..*') &&
             email.size() >= 5 &&
             email.size() <= 254;
    }
    
    /// Vérifie un numéro de téléphone NZ (format basique)
    function isValidNZPhone(phone) {
      return phone is string &&
             phone.size() >= 8 &&
             phone.size() <= 15;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🛡️ SECTION 3: SECURITY HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════
    
    /// Vérifie que seuls certains champs sont modifiés
    function onlyUpdating(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }
    
    /// Vérifie qu'un champ spécifique n'a pas changé
    function fieldUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }
    
    /// Vérifie que plusieurs champs n'ont pas changé
    function fieldsUnchanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
    }
    
    /// Vérifie si un document existe
    function docExists(collection, docId) {
      return exists(/databases/$(database)/documents/$(collection)/$(docId));
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 📊 SECTION 4: BUSINESS LOGIC FUNCTIONS  
    // ═══════════════════════════════════════════════════════════════════
    
    /// Vérifie si l'utilisateur est participant d'une conversation
    function isConversationParticipant(conversationId) {
      return isAuthenticated() &&
             currentUserId() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // ═══════════════════════════════════════════════════════════════════
    //
    //                    📁 COLLECTION RULES
    //
    // ═══════════════════════════════════════════════════════════════════
    // ═══════════════════════════════════════════════════════════════════
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 👤 USERS - Profils utilisateurs
    // ═══════════════════════════════════════════════════════════════════
    //
    // Sécurité:
    // ✅ Lecture: Tous les utilisateurs authentifiés (pour afficher vendeurs)
    // ✅ Création: Seulement son propre profil avec champs obligatoires
    // ✅ Modification: Champs limités, pas de données sensibles
    // ❌ Suppression: Interdite (soft delete via admin)
    // 🛡️ Protection: isAdmin, banned, createdAt non modifiables par l'utilisateur
    //
    
    match /users/{userId} {
      
      // LECTURE: Utilisateur authentifié
      allow read: if isAuthenticated();
      
      // CRÉATION: Son propre profil uniquement
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
                      request.resource.data.uid == userId &&
                      isValidEmail(request.resource.data.email) &&
                      isValidString(request.resource.data.displayName, 1, 100) &&
                      request.resource.data.get('isAdmin', false) == false &&
                      request.resource.data.get('banned', false) == false;
      
      // MODIFICATION: Champs limités par l'utilisateur
      allow update: if isOwner(userId) &&
                      onlyUpdating(['displayName', 'photoURL', 'phone', 'location', 'bio', 'lastLogin', 'updatedAt']) &&
                      (fieldUnchanged('displayName') || isValidString(request.resource.data.displayName, 1, 100)) &&
                      (fieldUnchanged('phone') || request.resource.data.phone == null || isValidNZPhone(request.resource.data.phone)) &&
                      (fieldUnchanged('bio') || request.resource.data.bio == null || isValidString(request.resource.data.bio, 0, 500));
      
      // MODIFICATION: Admin peut tout modifier
      allow update: if isAdmin();
      
      // SUPPRESSION: Interdite
      allow delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🏦 STRIPE ACCOUNTS - Comptes Stripe Connect
    // ═══════════════════════════════════════════════════════════════════
    //
    // 🛡️ ULTRA-SÉCURISÉ: Données financières sensibles
    // Seules les Cloud Functions peuvent créer/modifier ces données
    //
    
    match /stripeAccounts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🚐 VANS - Annonces de véhicules
    // ═══════════════════════════════════════════════════════════════════
    //
    // Sécurité:
    // ✅ Lecture: Publique (marketplace)
    // ✅ Création: Utilisateur authentifié avec validation stricte
    // ✅ Modification: Vendeur (champs limités) ou Admin (tout)
    // ✅ Suppression: Vendeur ou Admin
    // 🛡️ Protection: views, createdAt, seller non modifiables par vendeur
    //
    
    match /vans/{vanId} {
      
      // LECTURE: Publique
      allow read: if true;
      
      // CRÉATION: Utilisateur authentifié avec validation complète
      allow create: if isAuthenticated() &&
                      request.resource.data.seller.uid == currentUserId() &&
                      request.resource.data.keys().hasAll([
                        'title', 'price', 'description', 'location', 
                        'year', 'mileage', 'images', 'seller', 
                        'views', 'createdAt', 'status'
                      ]) &&
                      isValidString(request.resource.data.title, 5, 200) &&
                      isValidPrice(request.resource.data.price) &&
                      isValidString(request.resource.data.description, 20, 5000) &&
                      isValidString(request.resource.data.location, 2, 100) &&
                      isValidYear(request.resource.data.year) &&
                      isValidMileage(request.resource.data.mileage) &&
                      hasValidImages(request.resource.data.images) &&
                      request.resource.data.views == 0 &&
                      request.resource.data.status == 'active' &&
                      request.resource.data.createdAt == request.time;
      
      // MODIFICATION: Vendeur (champs limités)
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.seller.uid &&
                      fieldsUnchanged(['views', 'createdAt', 'seller']) &&
                      (fieldUnchanged('price') || isValidPrice(request.resource.data.price)) &&
                      (fieldUnchanged('title') || isValidString(request.resource.data.title, 5, 200)) &&
                      (fieldUnchanged('description') || isValidString(request.resource.data.description, 20, 5000)) &&
                      (fieldUnchanged('status') || request.resource.data.status in ['active', 'sold', 'paused', 'deleted']);
      
      // MODIFICATION: Admin peut tout
      allow update: if isAdmin();
      
      // MODIFICATION: Incrémentation des vues uniquement (+1)
      allow update: if isAuthenticated() &&
                      onlyUpdating(['views', 'lastViewedAt']) &&
                      request.resource.data.views == resource.data.views + 1;
      
      // SUPPRESSION: Vendeur ou Admin
      allow delete: if isAdmin() || 
                      (isAuthenticated() && currentUserId() == resource.data.seller.uid);
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // ❤️ FAVORITES - Favoris utilisateurs
    // ═══════════════════════════════════════════════════════════════════
    
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && currentUserId() == resource.data.userId;
      
      allow create: if isAuthenticated() && 
                      currentUserId() == request.resource.data.userId &&
                      request.resource.data.keys().hasAll(['userId', 'vanId', 'createdAt']) &&
                      isNonEmptyString(request.resource.data.vanId);
      
      allow update: if false;
      
      allow delete: if isAuthenticated() && currentUserId() == resource.data.userId;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 💬 CONVERSATIONS - Messagerie
    // ═══════════════════════════════════════════════════════════════════
    
    match /conversations/{conversationId} {
      
      allow read: if isAuthenticated() && currentUserId() in resource.data.participants;
      
      allow create: if isAuthenticated() && 
                      currentUserId() in request.resource.data.participants &&
                      request.resource.data.participants.size() == 2 &&
                      request.resource.data.keys().hasAll(['participants', 'createdAt', 'vanId']);
      
      allow update: if isAuthenticated() && 
                      currentUserId() in resource.data.participants &&
                      fieldUnchanged('participants') &&
                      fieldUnchanged('vanId') &&
                      fieldUnchanged('createdAt') &&
                      onlyUpdating(['lastMessage', 'lastMessageAt', 'updatedAt']);
      
      allow delete: if isAdmin();
      
      // 📨 MESSAGES - Sous-collection
      match /messages/{messageId} {
        
        allow read: if isConversationParticipant(conversationId);
        
        allow create: if isConversationParticipant(conversationId) &&
                        request.resource.data.senderId == currentUserId() &&
                        request.resource.data.senderId != 'system' &&
                        isValidString(request.resource.data.text, 1, 2000) &&
                        request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt']);
        
        allow update: if isConversationParticipant(conversationId) &&
                        currentUserId() != resource.data.senderId &&
                        onlyUpdating(['read', 'readAt']);
        
        allow delete: if false;
      }
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // ⭐ REVIEWS - Avis sur les vendeurs
    // ═══════════════════════════════════════════════════════════════════
    
    match /reviews/{reviewId} {
      
      allow read: if true;
      
      allow create: if isAuthenticated() && 
                      request.resource.data.reviewerId == currentUserId() &&
                      request.resource.data.reviewerId != request.resource.data.sellerId &&
                      isValidRating(request.resource.data.rating) &&
                      isValidString(request.resource.data.comment, 0, 1000) &&
                      request.resource.data.keys().hasAll(['reviewerId', 'sellerId', 'rating', 'comment', 'createdAt']);
      
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.reviewerId &&
                      fieldUnchanged('reviewerId') &&
                      fieldUnchanged('sellerId') &&
                      fieldUnchanged('createdAt') &&
                      onlyUpdating(['rating', 'comment', 'updatedAt']) &&
                      isValidRating(request.resource.data.rating);
      
      allow delete: if isAuthenticated() && 
                      (currentUserId() == resource.data.reviewerId || isAdmin());
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 💳 RESERVATIONS - Double Confirmation System
    // ═══════════════════════════════════════════════════════════════════
    //
    // FLUX SÉCURISÉ:
    // ┌─────────────────────────────────────────────────────────────┐
    // │ 1. pending → paid         (Cloud Function après Stripe)    │
    // │ 2. paid → buyer_confirmed (Buyer + photo obligatoire)      │
    // │ 3. buyer_confirmed → completed (Seller confirme)           │
    // │ 4. completed → payout     (Cloud Function auto)            │
    // └─────────────────────────────────────────────────────────────┘
    //
    
    match /reservations/{reservationId} {
      
      // LECTURE: Buyer, Seller, ou Admin
      allow read: if isAuthenticated() && 
                    (currentUserId() == resource.data.buyerId || 
                     currentUserId() == resource.data.sellerId ||
                     isAdmin());
      
      // CRÉATION: Cloud Functions UNIQUEMENT
      allow create: if false;
      
      // MODIFICATION PAR BUYER
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.buyerId &&
                      (
                        // ANNULATION avant confirmation
                        (
                          resource.data.status in ['pending', 'paid'] &&
                          resource.data.buyerConfirmed != true &&
                          request.resource.data.status == 'cancelled' &&
                          onlyUpdating(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason', 'updatedAt']) &&
                          request.resource.data.cancelledBy == currentUserId()
                        )
                        ||
                        // CONFIRMATION avec photo obligatoire
                        (
                          resource.data.status == 'paid' &&
                          (resource.data.buyerConfirmed == false || 
                           resource.data.buyerConfirmed == null ||
                           !('buyerConfirmed' in resource.data)) &&
                          request.resource.data.buyerConfirmed == true &&
                          isNonEmptyString(request.resource.data.buyerConfirmationPhoto) &&
                          request.resource.data.status == 'buyer_confirmed' &&
                          onlyUpdating(['status', 'buyerConfirmed', 'buyerConfirmedAt', 'buyerConfirmationPhoto', 'updatedAt'])
                        )
                        ||
                        // DISPUTE
                        (
                          resource.data.status == 'buyer_confirmed' &&
                          resource.data.buyerConfirmed == true &&
                          request.resource.data.status == 'disputed' &&
                          isValidString(request.resource.data.disputeReason, 10, 1000) &&
                          onlyUpdating(['status', 'disputeReason', 'disputeOpenedAt', 'disputeOpenedBy', 'updatedAt']) &&
                          request.resource.data.disputeOpenedBy == currentUserId()
                        )
                      );
      
      // MODIFICATION PAR SELLER
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.sellerId &&
                      (
                        // ANNULATION avant confirmation buyer
                        (
                          resource.data.status in ['pending', 'paid'] &&
                          resource.data.buyerConfirmed != true &&
                          request.resource.data.status == 'cancelled' &&
                          onlyUpdating(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason', 'updatedAt']) &&
                          request.resource.data.cancelledBy == currentUserId()
                        )
                        ||
                        // CONFIRMATION après buyer (déclenche payout)
                        (
                          resource.data.status == 'buyer_confirmed' &&
                          resource.data.buyerConfirmed == true &&
                          isNonEmptyString(resource.data.buyerConfirmationPhoto) &&
                          (resource.data.sellerConfirmed == false || 
                           resource.data.sellerConfirmed == null ||
                           !('sellerConfirmed' in resource.data)) &&
                          request.resource.data.sellerConfirmed == true &&
                          request.resource.data.status == 'completed' &&
                          onlyUpdating(['status', 'sellerConfirmed', 'sellerConfirmedAt', 'updatedAt'])
                        )
                      );
      
      // MODIFICATION: Admin peut tout
      allow update: if isAdmin();
      
      // SUPPRESSION: Interdite (historique légal)
      allow delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🔔 NOTIFICATIONS
    // ═══════════════════════════════════════════════════════════════════
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
                    (currentUserId() == resource.data.userId || isAdmin());
      allow create: if false;
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.userId &&
                      onlyUpdating(['read', 'readAt']);
      allow delete: if isAuthenticated() && currentUserId() == resource.data.userId;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 💰 PAYOUTS - Historique des paiements vendeurs
    // ═══════════════════════════════════════════════════════════════════
    
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && 
                    (currentUserId() == resource.data.sellerId || isAdmin());
      allow create, update, delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 📸 CONFIRMATIONS - Métadonnées photos de preuve
    // ═══════════════════════════════════════════════════════════════════
    
    match /confirmations/{confirmationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🚨 REPORTS - Signalements
    // ═══════════════════════════════════════════════════════════════════
    
    match /reports/{reportId} {
      allow read: if isAuthenticated() && 
                    (currentUserId() == resource.data.reporterId || isAdmin());
      
      allow create: if isAuthenticated() &&
                      request.resource.data.reporterId == currentUserId() &&
                      request.resource.data.type in ['spam', 'scam', 'inappropriate', 'fake', 'other'] &&
                      isValidString(request.resource.data.reason, 10, 1000) &&
                      request.resource.data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'type', 'reason', 'createdAt']) &&
                      request.resource.data.targetType in ['van', 'user', 'message', 'review'];
      
      allow update, delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // ⚙️ SETTINGS - Configuration système
    // ═══════════════════════════════════════════════════════════════════
    
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🚫 CATCH-ALL: BLOQUER TOUT LE RESTE
    // ═══════════════════════════════════════════════════════════════════
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
