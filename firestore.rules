rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ╔══════════════════════════════════════════════════════════════════╗
    // ║                                                                   ║
    // ║   🥝 KIWI VAN MARKET - FIRESTORE SECURITY RULES                  ║
    // ║                                                                   ║
    // ║   Reviewed: 15 October 2026                                       ║
    // ║   Scope and remaining risks: docs/audit-access-2026-10-15.md       ║
    // ║   Review does not constitute a security certification.            ║
    // ║                                                                   ║
    // ╚══════════════════════════════════════════════════════════════════╝
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🔐 SECTION 1: AUTHENTICATION FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════
    
    function isAuthenticated() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function hasVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }
    
    function currentUserId() {
      return request.auth.uid;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 📏 SECTION 2: VALIDATION FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════
    
    function isValidString(field, minLen, maxLen) {
      return field is string && 
             field.size() >= minLen && 
             field.size() <= maxLen;
    }
    
    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }
    
    function isValidPrice(price) {
      return price is number && price >= 1 && price <= 500000;
    }
    
    function isValidYear(year) {
      return year is number && year >= 1950 && year <= 2030;
    }
    
    function isValidMileage(mileage) {
      return mileage is number && mileage >= 0 && mileage <= 1000000;
    }
    
    function isValidRating(rating) {
      return rating is number && rating >= 1 && rating <= 5;
    }
    
    function hasValidImages(images) {
      // Join once to validate the whole bounded list without exceeding the Rules expression budget.
      return images is list && images.size() >= 1 && images.size() <= 10 &&
             images.join('|').size() <= 20480 &&
             images.join('|').matches('^https://(res[.]cloudinary[.]com|firebasestorage[.]googleapis[.]com)/[^|]+([|]https://(res[.]cloudinary[.]com|firebasestorage[.]googleapis[.]com)/[^|]+)*$');
    }

    function isValidImageUrl(url) {
      return isValidString(url, 1, 2048) &&
             url.matches('^https://(res[.]cloudinary[.]com|firebasestorage[.]googleapis[.]com)/.+');
    }

    function optionalString(data, key, maxLength) {
      let value = data.get(key, null);
      return value == null || (value is string && value.size() <= maxLength);
    }

    function optionalNumber(data, key, minimum, maximum) {
      let value = data.get(key, null);
      return value == null || (value is number && value >= minimum && value <= maximum);
    }

    function optionalDate(data, key) {
      let value = data.get(key, null);
      return value == null || value is timestamp || (value is string && value.size() <= 32);
    }

    // Check only modified optional fields on update, so old listings remain editable.
    function hasValidOptionalListingFields(data, changed) {
      let equipment = data.get('equipment', {});
      return (!('region' in changed) || (data.region is string && data.region.size() <= 100)) &&
             (!('type' in changed) || (data.type is string && data.type.size() <= 50)) &&
             (!('fuelType' in changed) || (data.fuelType is string && data.fuelType.size() <= 32)) &&
             (!('transmission' in changed) || (data.transmission is string && data.transmission.size() <= 32)) &&
             (!('capacity' in changed) || optionalNumber(data, 'capacity', 1, 20)) &&
             (!('selfContained' in changed) || data.get('selfContained', false) is bool) &&
             (!('selfContainedType' in changed) || optionalString(data, 'selfContainedType', 32)) &&
             (!('equipment' in changed) || (equipment is map &&
               equipment.keys().hasOnly(['doubleBed', 'singleBeds', 'roofBed', 'bedding', 'curtains',
                 'fridge', 'gasStove', 'sink', 'cookware', 'freshWaterTank', 'greyWaterTank', 'outdoorShower',
                 'indoorShower', 'toilet', 'portaPotti', 'solarPanel', 'leisureBattery', 'splitCharger',
                 'inverter', 'usb', 'ledLights', 'heater', 'dieselHeater', 'roofFan', 'insulation', 'awning',
                 'reverseCamera', 'bluetooth', 'swivelSeats', 'bikeRack', 'surfRack']) &&
               equipment.values().hasOnly([true, false]))) &&
             (!('buyBack' in changed) || data.get('buyBack', false) is bool) &&
             (!('buyBackPrice' in changed) || optionalNumber(data, 'buyBackPrice', 0, 500000)) &&
             (!('buyBackDuration' in changed) || optionalNumber(data, 'buyBackDuration', 0, 120)) &&
             (!('buyBackMaxKm' in changed) || optionalNumber(data, 'buyBackMaxKm', 0, 1000000)) &&
             (!('buyBackConditions' in changed) || (data.buyBackConditions is string && data.buyBackConditions.size() <= 5000)) &&
             (!('wofExpiry' in changed) || optionalDate(data, 'wofExpiry')) &&
             (!('regoExpiry' in changed) || optionalDate(data, 'regoExpiry')) &&
             (!('customFeatures' in changed) || (data.customFeatures is string && data.customFeatures.size() <= 2000)) &&
             (!('imageUrl' in changed) || data.get('imageUrl', null) == null || isValidImageUrl(data.imageUrl)) &&
             (!('hasDirectContact' in changed) || data.get('hasDirectContact', false) is bool) &&
             (!('plateNumber' in changed) || (data.plateNumber is string && data.plateNumber.size() <= 20));
    }

    function isSellerEditableStatus(status) {
      return status in ['active', 'sold', 'paused'];
    }

    function hasValidConversationMaps(data, changed) {
      return (!('participantNames' in changed) || data.get('participantNames', null) == null ||
               (data.participantNames is map && data.participantNames.keys().hasOnly(data.participants) &&
                optionalString(data.participantNames, data.buyerId, 100) && optionalString(data.participantNames, data.sellerId, 100))) &&
             (!('participantEmails' in changed) || data.get('participantEmails', null) == null ||
               (data.participantEmails is map && data.participantEmails.keys().hasOnly(data.participants) &&
                optionalString(data.participantEmails, data.buyerId, 254) && optionalString(data.participantEmails, data.sellerId, 254))) &&
             (!('unreadCount' in changed) ||
               (data.unreadCount is map && data.unreadCount.keys().hasOnly(data.participants) &&
                data.unreadCount.get(data.buyerId, 0) is int && data.unreadCount.get(data.sellerId, 0) is int &&
                data.unreadCount.get(data.buyerId, 0) >= 0 && data.unreadCount.get(data.sellerId, 0) >= 0 &&
                data.unreadCount.get(data.buyerId, 0) <= 100000 && data.unreadCount.get(data.sellerId, 0) <= 100000)) &&
             (!('typing' in changed) ||
               (data.typing is map && data.typing.keys().hasOnly(data.participants) && data.typing.values().hasOnly([true, false])));
    }

    function hasValidConversationVan(data) {
      let van = data.get('van', null);
      return van == null || (van is map &&
             van.keys().hasOnly(['id', 'title', 'price', 'imageUrl', 'year', 'mileage', 'location',
               'wofExpiry', 'regoExpiry', 'selfContained', 'buyBack', 'buyBackPrice', 'buyBackDuration', 'status']) &&
             van.id == data.vanId && isValidString(van.title, 3, 200) && isValidPrice(van.price) &&
             van.title == get(/databases/$(database)/documents/vans/$(data.vanId)).data.title &&
             van.price == get(/databases/$(database)/documents/vans/$(data.vanId)).data.price &&
             optionalString(van, 'location', 100) && optionalNumber(van, 'year', 1950, 2030) &&
             optionalNumber(van, 'mileage', 0, 1000000) &&
             (van.get('imageUrl', null) == null || isValidImageUrl(van.imageUrl)) &&
             optionalDate(van, 'wofExpiry') && optionalDate(van, 'regoExpiry') &&
             (van.get('selfContained', false) is bool) && (van.get('buyBack', false) is bool) &&
             optionalNumber(van, 'buyBackPrice', 0, 500000) && optionalNumber(van, 'buyBackDuration', 0, 120) &&
             (van.get('status', 'active') in ['active', 'sold', 'paused']));
    }
    
    function isValidEmail(email) {
      return email is string && 
             email.matches('.*@.*\\..*') &&
             email.size() >= 5 &&
             email.size() <= 254;
    }
    
    function isValidNZPhone(phone) {
      return phone is string &&
             phone.matches('^[+]?[0-9]{8,15}$');
    }

    function hasNoPublicContact(data) {
      return data.get('email', null) == null &&
             data.get('phone', null) == null &&
             data.get('whatsapp', null) == null &&
             data.seller.get('email', null) == null &&
             data.seller.get('phone', null) == null &&
             data.seller.get('whatsapp', null) == null;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🛡️ SECTION 3: SECURITY HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════
    
    function onlyUpdating(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }
    
    function fieldUnchanged(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }
    
    function fieldsUnchanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 📊 SECTION 4: BUSINESS LOGIC FUNCTIONS  
    // ═══════════════════════════════════════════════════════════════════
    
    function isConversationParticipant(conversationId) {
      return isAuthenticated() &&
             currentUserId() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function isValidReservationCreate(vanDoc) {
      return request.resource.data.keys().hasOnly([
               'vanId', 'van', 'vanTitle', 'vanPrice', 'vanImage', 'vanLocation', 'vanYear',
               'sellerId', 'sellerName', 'sellerEmail',
               'buyerId', 'buyerName', 'buyerEmail',
               'depositAmount', 'platformFee', 'sellerPayout', 'remainingBalance',
               'currency', 'status', 'createdAt', 'expiresAt', 'validUntil'
             ]) &&
             request.resource.data.status == 'pending' &&
             request.resource.data.buyerId == currentUserId() &&
             request.resource.data.buyerId != request.resource.data.sellerId &&
             request.resource.data.vanId is string &&
             request.resource.data.vanId.size() > 0 &&
             request.resource.data.van is map &&
             request.resource.data.van.id == request.resource.data.vanId &&
             request.resource.data.vanPrice is number &&
             request.resource.data.vanPrice == vanDoc.data.price &&
             request.resource.data.sellerId == vanDoc.data.seller.uid &&
             vanDoc.data.status == 'active' &&
             request.resource.data.depositAmount is number &&
             request.resource.data.depositAmount >= 500 &&
             request.resource.data.depositAmount <= request.resource.data.vanPrice &&
             request.resource.data.platformFee is number &&
             request.resource.data.platformFee >= 0 &&
             request.resource.data.platformFee <= request.resource.data.depositAmount &&
             request.resource.data.sellerPayout is number &&
             request.resource.data.sellerPayout == request.resource.data.depositAmount - request.resource.data.platformFee &&
             request.resource.data.remainingBalance is number &&
             request.resource.data.remainingBalance == request.resource.data.vanPrice - request.resource.data.depositAmount &&
             request.resource.data.currency in ['NZD', 'nzd'];
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 👤 USERS
    // ═══════════════════════════════════════════════════════════════════
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
                      request.resource.data.uid == userId &&
                      isValidEmail(request.resource.data.email) &&
                      request.resource.data.email == request.auth.token.email &&
                      isValidString(request.resource.data.displayName, 1, 100) &&
                      request.resource.data.get('isAdmin', false) == false &&
                      request.resource.data.get('banned', false) == false &&
                      !request.resource.data.keys().hasAny(['stripeAccountId', 'balance', 'payoutsEnabled', 'role', 'roles']);
      
      allow update: if isOwner(userId) &&
                      onlyUpdating(['displayName', 'photoURL', 'phone', 'location', 'city', 'region', 'bio', 'lastActive', 'lastLogin', 'updatedAt']) &&
                      (fieldUnchanged('city') || isValidString(request.resource.data.city, 0, 100)) &&
                      (fieldUnchanged('region') || isValidString(request.resource.data.region, 0, 100)) &&
                      (fieldUnchanged('displayName') || isValidString(request.resource.data.displayName, 1, 100)) &&
                      (fieldUnchanged('phone') || request.resource.data.phone == null || isValidNZPhone(request.resource.data.phone)) &&
                      (fieldUnchanged('bio') || request.resource.data.bio == null || isValidString(request.resource.data.bio, 0, 500));
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    // ═══════════════════════════════════════════════════════════════════
    // 🏦 STRIPE ACCOUNTS
    // ═══════════════════════════════════════════════════════════════════
    
    match /stripeAccounts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /boostOrders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == currentUserId() || isAdmin());
      allow create, update, delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🚐 VANS
    // ═══════════════════════════════════════════════════════════════════
    
    match /vans/{vanId} {
      allow read: if true;

      // Coordonnees du vendeur, sorties du document public.
      // Firestore ne sait proteger qu'un DOCUMENT, jamais un champ : tant que
      // le telephone et l'email vivaient dans vans/{vanId} — lisible par tous,
      // ce qui est indispensable au SEO et a la navigation anonyme — ils
      // etaient aspirables en une requete. Le verrou "connexion requise" pose
      // sur la fiche van n'etait donc que cosmetique.
      match /private/{docId} {
        allow read: if docId == 'contact' && hasVerifiedEmail() &&
                       exists(/databases/$(database)/documents/vans/$(vanId));
        allow write: if docId == 'contact' && hasVerifiedEmail() &&
                        request.resource.data.keys().hasOnly(['email', 'phone', 'whatsapp']) &&
                        request.resource.data.email == request.auth.token.email &&
                        optionalString(request.resource.data, 'phone', 64) &&
                        optionalString(request.resource.data, 'whatsapp', 64) &&
                        currentUserId() == get(/databases/$(database)/documents/vans/$(vanId)).data.seller.uid;
      }

      function validListingCreate() {
        let data = request.resource.data;
        let keys = data.keys().toSet();
        return
                      hasNoPublicContact(data) &&
                      keys.hasOnly([
                        'title', 'price', 'description', 'location', 'region', 'year', 'mileage',
                        'type', 'fuelType', 'transmission', 'capacity', 'selfContained', 'selfContainedType',
                        'equipment', 'buyBack', 'buyBackPrice', 'buyBackDuration', 'buyBackMaxKm',
                        'buyBackConditions', 'wofExpiry', 'regoExpiry', 'customFeatures', 'imageUrl',
                        'images', 'imageFocusX', 'imageFocusY', 'imageZoom', 'imageCrops', 'seller',
                        'userId', 'hasDirectContact', 'plateNumber', 'views', 'createdAt', 'updatedAt', 'status'
                      ]) &&
                      data.get('userId', currentUserId()) == currentUserId() &&
                      data.get('featured', false) == false &&
                      data.seller.uid == currentUserId() &&
                      data.seller.keys().hasOnly(['uid', 'name']) &&
                      isValidString(data.seller.name, 1, 100) &&
                      keys.hasAll([
                        'title', 'price', 'description', 'location', 
                        'year', 'mileage', 'images', 'seller', 
                        'views', 'createdAt', 'status'
                      ]) &&
                      isValidString(data.title, 3, 200) &&
                      isValidPrice(data.price) &&
                      isValidString(data.description, 10, 5000) &&
                      isValidString(data.location, 2, 100) &&
                      isValidYear(data.year) &&
                      isValidMileage(data.mileage) &&
                      hasValidImages(data.images) &&
                      hasValidOptionalListingFields(data, data) &&
                      data.views == 0 &&
                      data.createdAt is timestamp &&
                      data.createdAt == request.time &&
                      data.status == 'active';
      }
      allow create: if hasVerifiedEmail() && validListingCreate();
      
      function validListingUpdate() {
        let data = request.resource.data;
        let previous = resource.data;
        let changed = data.diff(previous).affectedKeys();
        return
                      currentUserId() == previous.seller.uid &&
                      hasNoPublicContact(data) &&
                      changed.hasOnly([
                        'title', 'price', 'description', 'location', 'region', 'year', 'mileage',
                        'type', 'fuelType', 'transmission', 'capacity', 'selfContained', 'selfContainedType',
                        'equipment', 'buyBack', 'buyBackPrice', 'buyBackDuration', 'buyBackMaxKm',
                        'buyBackConditions', 'wofExpiry', 'regoExpiry', 'customFeatures', 'imageUrl',
                        'images', 'imageFocusX', 'imageFocusY', 'imageZoom', 'imageCrops', 'seller',
                        'hasDirectContact', 'plateNumber', 'updatedAt', 'status'
                      ]) &&
                      (!('seller' in changed) || (
                        data.seller.uid == previous.seller.uid &&
                        // whatsapp inclus : le formulaire d'édition permet de le
                        // modifier — sans lui, tout update touchant le WhatsApp
                        // était refusé.
                        // Le formulaire remet les anciennes coordonnees a null.
                        // hasNoPublicContact impose que email/phone/whatsapp restent null.
                        data.seller.diff(previous.seller).affectedKeys().hasOnly(['phone', 'facebook', 'whatsapp', 'email'])
                      )) &&
                      (!('price' in changed) || isValidPrice(data.price)) &&
                      (!('title' in changed) || isValidString(data.title, 3, 200)) &&
                      (!('description' in changed) || isValidString(data.description, 10, 5000)) &&
                      (!('location' in changed) || isValidString(data.location, 2, 100)) &&
                      (!('year' in changed) || isValidYear(data.year)) &&
                      (!('mileage' in changed) || isValidMileage(data.mileage)) &&
                      (!('images' in changed) || hasValidImages(data.images)) &&
                      hasValidOptionalListingFields(data, changed) &&
                      (!('status' in changed) ||
                       (isSellerEditableStatus(previous.get('status', 'active')) && isSellerEditableStatus(data.status)));
      }
      allow update: if isAuthenticated() && validListingUpdate();
      
      allow update: if isAdmin();
      
      allow update: if isAuthenticated() &&
                      onlyUpdating(['views', 'lastViewedAt']) &&
                      request.resource.data.views == resource.data.views + 1;
      
      allow delete: if isAdmin() || 
                      (isAuthenticated() && currentUserId() == resource.data.seller.uid);
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // ❤️ FAVORITES
    // ═══════════════════════════════════════════════════════════════════
    
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && currentUserId() == resource.data.userId;
      
      allow create: if isAuthenticated() && 
                      currentUserId() == request.resource.data.userId &&
                      request.resource.data.keys().hasAll(['userId', 'vanId', 'createdAt']) &&
                      isNonEmptyString(request.resource.data.vanId);
      
      allow update: if false;
      allow delete: if isAuthenticated() && currentUserId() == resource.data.userId;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 💬 CONVERSATIONS - FIX v2.1.0
    // ═══════════════════════════════════════════════════════════════════
    
    match /conversations/{conversationId} {
      allow read: if (isAuthenticated() && currentUserId() in resource.data.participants) || isAdmin();
      
      allow create: if hasVerifiedEmail() &&
                      request.resource.data.keys().hasOnly([
                        'participants', 'createdAt', 'vanId',
                        'sellerId', 'buyerId', 'buyerName',
                        'participantNames', 'participantEmails',
                        'van', 'status', 'lastMessage', 'lastMessageAt',
                        'lastMessageSenderId', 'unreadCount', 'typing',
                        'updatedAt'
                      ]) &&
                      request.resource.data.participants is list &&
                      currentUserId() in request.resource.data.participants &&
                      request.resource.data.participants.size() == 2 &&
                      request.resource.data.participants[0] != request.resource.data.participants[1] &&
                      request.resource.data.buyerId in request.resource.data.participants &&
                      request.resource.data.sellerId in request.resource.data.participants &&
                      request.resource.data.buyerId != request.resource.data.sellerId &&
                      request.resource.data.buyerId == currentUserId() &&
                      isValidString(request.resource.data.vanId, 1, 128) &&
                      exists(/databases/$(database)/documents/vans/$(request.resource.data.vanId)) &&
                      request.resource.data.sellerId == get(/databases/$(database)/documents/vans/$(request.resource.data.vanId)).data.seller.uid &&
                      request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time &&
                      optionalString(request.resource.data, 'buyerName', 100) &&
                      optionalString(request.resource.data, 'lastMessage', 2000) &&
                      (request.resource.data.get('lastMessageSenderId', currentUserId()) == currentUserId()) &&
                      (request.resource.data.get('lastMessageAt', request.time) == request.time) &&
                      (request.resource.data.get('status', 'new') in ['new', 'active']) &&
                      hasValidConversationMaps(request.resource.data, request.resource.data.keys().toSet()) &&
                      hasValidConversationVan(request.resource.data) &&
                      request.resource.data.keys().hasAll(['participants', 'createdAt', 'vanId']);
      
      allow update: if isAuthenticated() &&
                      currentUserId() in resource.data.participants &&
                      fieldUnchanged('participants') &&
                      fieldUnchanged('vanId') &&
                      fieldUnchanged('createdAt') &&
                      (fieldUnchanged('status') || request.resource.data.status in ['new', 'active', 'pending', 'resolved', 'archived', 'closed']) &&
                      (fieldUnchanged('lastMessage') || isValidString(request.resource.data.lastMessage, 1, 2000)) &&
                      (fieldsUnchanged(['lastMessage', 'lastMessageAt', 'lastMessageSenderId']) || request.resource.data.lastMessageSenderId == currentUserId()) &&
                      (fieldUnchanged('lastMessageAt') || request.resource.data.lastMessageAt == request.time) &&
                      (fieldUnchanged('updatedAt') || request.resource.data.updatedAt is timestamp) &&
                      hasValidConversationMaps(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'lastMessage', 'lastMessageAt', 'lastMessageSenderId',
                        'status', 'unreadCount', 'typing', 'updatedAt'
                      ]);
      
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId) || isAdmin();
        
        allow create: if hasVerifiedEmail() &&
                        isConversationParticipant(conversationId) &&
                        request.resource.data.senderId == currentUserId() &&
                        request.resource.data.senderId != 'system' &&
                        isValidString(request.resource.data.text, 1, 2000) &&
                        optionalString(request.resource.data, 'senderName', 100) &&
                        request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time &&
                        request.resource.data.get('read', false) == false &&
                        request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt', 'read']) &&
                        request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt']);
        
        allow update: if isConversationParticipant(conversationId) &&
                        currentUserId() != resource.data.senderId &&
                        onlyUpdating(['read', 'readAt']);
        
        allow delete: if false;
      }
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // ⭐ REVIEWS
    // ═══════════════════════════════════════════════════════════════════
    
    match /reviews/{reviewId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && 
                      request.resource.data.reviewerId == currentUserId() &&
                      request.resource.data.reviewerId != request.resource.data.sellerId &&
                      isValidRating(request.resource.data.rating) &&
                      isValidString(request.resource.data.comment, 0, 1000) &&
                      request.resource.data.keys().hasAll(['reviewerId', 'sellerId', 'rating', 'comment', 'createdAt']);
      
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.reviewerId &&
                      fieldUnchanged('reviewerId') &&
                      fieldUnchanged('sellerId') &&
                      fieldUnchanged('createdAt') &&
                      onlyUpdating(['rating', 'comment', 'updatedAt']) &&
                      isValidRating(request.resource.data.rating);
      
      allow delete: if isAuthenticated() && 
                      (currentUserId() == resource.data.reviewerId || isAdmin());
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 💳 RESERVATIONS
    // ═══════════════════════════════════════════════════════════════════
    
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && 
                    (currentUserId() == resource.data.buyerId || 
                     currentUserId() == resource.data.sellerId ||
                     isAdmin());
      
      allow create: if hasVerifiedEmail() &&
                      exists(/databases/$(database)/documents/vans/$(request.resource.data.vanId)) &&
                      isValidReservationCreate(get(/databases/$(database)/documents/vans/$(request.resource.data.vanId)));
      
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.buyerId &&
                      (
                        (
                          resource.data.status == 'pending' &&
                          !('checkoutSessionId' in resource.data) &&
                          resource.data.buyerConfirmed != true &&
                          request.resource.data.status == 'cancelled' &&
                          onlyUpdating(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason', 'updatedAt']) &&
                          request.resource.data.cancelledBy == currentUserId()
                        )
                        ||
                        (
                          resource.data.status in ['paid', 'confirmed'] &&
                          (resource.data.buyerConfirmed == false || 
                           resource.data.buyerConfirmed == null ||
                           !('buyerConfirmed' in resource.data)) &&
                          request.resource.data.buyerConfirmed == true &&
                          isNonEmptyString(request.resource.data.buyerConfirmationPhoto) &&
                          request.resource.data.status == 'buyer_confirmed' &&
                          onlyUpdating(['status', 'buyerConfirmed', 'buyerConfirmedAt', 'buyerConfirmationPhoto', 'updatedAt'])
                        )
                        ||
                        (
                          resource.data.status == 'buyer_confirmed' &&
                          resource.data.buyerConfirmed == true &&
                          request.resource.data.status == 'disputed' &&
                          isValidString(request.resource.data.disputeReason, 10, 1000) &&
                          onlyUpdating(['status', 'disputeReason', 'disputeOpenedAt', 'disputeOpenedBy', 'updatedAt']) &&
                          request.resource.data.disputeOpenedBy == currentUserId()
                        )
                      );
      
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.sellerId &&
                      (
                        (
                          resource.data.status == 'pending' &&
                          !('checkoutSessionId' in resource.data) &&
                          resource.data.buyerConfirmed != true &&
                          request.resource.data.status == 'cancelled' &&
                          onlyUpdating(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason', 'updatedAt']) &&
                          request.resource.data.cancelledBy == currentUserId()
                        )
                        ||
                        (
                          resource.data.status == 'buyer_confirmed' &&
                          resource.data.buyerConfirmed == true &&
                          isNonEmptyString(resource.data.buyerConfirmationPhoto) &&
                          (resource.data.sellerConfirmed == false || 
                           resource.data.sellerConfirmed == null ||
                           !('sellerConfirmed' in resource.data)) &&
                          request.resource.data.sellerConfirmed == true &&
                          request.resource.data.status == 'completed' &&
                          onlyUpdating(['status', 'sellerConfirmed', 'sellerConfirmedAt', 'updatedAt'])
                        )
                      );
      
      allow update: if isAdmin();
      allow delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🔔 NOTIFICATIONS
    // ═══════════════════════════════════════════════════════════════════
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
                    (currentUserId() == resource.data.userId || isAdmin());
      allow create: if false;
      allow update: if isAuthenticated() && 
                      currentUserId() == resource.data.userId &&
                      onlyUpdating(['read', 'readAt']);
      allow delete: if isAuthenticated() && currentUserId() == resource.data.userId;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 💰 PAYOUTS
    // ═══════════════════════════════════════════════════════════════════
    
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && 
                    (currentUserId() == resource.data.sellerId || isAdmin());
      allow create, update, delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 📸 CONFIRMATIONS
    // ═══════════════════════════════════════════════════════════════════
    
    match /confirmations/{confirmationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🚨 REPORTS
    // ═══════════════════════════════════════════════════════════════════
    
    match /reports/{reportId} {
      allow read: if isAuthenticated() && 
                    (currentUserId() == resource.data.reporterId || isAdmin());
      
      allow create: if isAuthenticated() &&
                      request.resource.data.reporterId == currentUserId() &&
                      request.resource.data.type in ['spam', 'scam', 'inappropriate', 'fake', 'other'] &&
                      isValidString(request.resource.data.reason, 10, 1000) &&
                      request.resource.data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'type', 'reason', 'createdAt']) &&
                      request.resource.data.targetType in ['van', 'user', 'message', 'review'];
      
      allow update, delete: if false;
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // ⚙️ SETTINGS
    // ═══════════════════════════════════════════════════════════════════
    
    match /settings/{settingId} {
      allow read: if settingId == 'public' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    
    // ═══════════════════════════════════════════════════════════════════
    // 🚫 CATCH-ALL
    // ═══════════════════════════════════════════════════════════════════
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
